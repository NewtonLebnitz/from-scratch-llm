{
  "token_manifest": "datasets/pretrain/bilingual/manifest.json",
  "model": {
    "vocab_size": 32000,
    "context_length": 1024,
    "d_model": 768,
    "num_layers": 18,
    "num_heads": 12,
    "num_kv_heads": 3,
    "d_ff": 2048,
    "rope_theta": 10000.0,
    "attention": "hopfield_official_v8",
    "hopfield_alpha": 0.5,
    "hopfield_alpha_prime": 0.5
  },
  "training": {
    "steps": 45000,
    "microbatch": 12,
    "accumulation": 4,
    "sequence_length": 512,
    "learning_rate": 0.0003,
    "min_learning_rate": 3e-05,
    "warmup_steps": 500,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "chinese_fraction": 0.5,
    "eval_every": 500,
    "eval_batches": 8,
    "save_every": 2000,
    "seed": 7
  }
}
